---
import Layout from "layouts/Layout.astro";
import Forumschedule from "components/Forumschedule.astro";
---

<Layout
  title="会议日程 - GOBI 2025"
  description="GOBI 2025 会议日程安排"
  navDarkMode={false}
  navBackground="light"
  pageTransitionName="schedule"
>
  <section class="section" data-theme-section="light" data-bg-section="light" style="padding-top: 200px; padding-bottom: 10px;">
    <div class="container">
      <div class="row" style="justify-content: center;">
        <div class="col" style="text-align: center; width: 100%;">
          <h1 style="font-family: 'Manrope', sans-serif; font-size: 2.1rem; text-align: center;">会议日程</h1>
          <p style="text-align: center;">GOBI 2025 同期活动安排</p>
        </div>
      </div>
    </div>
  </section>

  <Forumschedule currentDay="12月21日" />
</Layout>