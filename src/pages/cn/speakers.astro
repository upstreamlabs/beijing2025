---
import Layout from "layouts/Layout.astro";
import SpeakerPageGrid from "components/SpeakerPageGrid.astro";

// Import JSON data
import speakersData from "json/SpeakersListZh.json";
---

<Layout
  title="演讲嘉宾 - GOBI 2025"
  description="GOBI 2025 演讲嘉宾"
  navDarkMode={false}
  navBackground="light"
  pageTransitionName="speakers"
>
  <section class="section" data-theme-section="light" data-bg-section="light" style="padding-top: 200px; padding-bottom: 10px;">
    <div class="container">
      <div class="row" style="justify-content: center;">
        <div class="col" style="text-align: center; width: 100%;">
          <h1 style="font-family: 'Manrope', sans-serif; font-size: 2.1rem; text-align: center;">演讲嘉宾</h1>
          <p style="text-align: center;">GOBI 2025 汇聚全球开源与AI领域的思想领袖</p>
        </div>
      </div>
    </div>
  </section>

  <SpeakerPageGrid speakers={speakersData} />
</Layout>
