---
import Layout from "layouts/Layout.astro";
import speakers from "json/SpeakersListEn.json";

export async function getStaticPaths() {
  return speakers.map(speaker => ({
    params: { id: speaker.id },
    props: { speaker },
  }));
}

const { speaker } = Astro.props;
---

<Layout
  title={`${speaker.name} - GOBI 2025`}
  description={speaker.bio}
  navDarkMode={false}
  navBackground="light"
>
  <section class="section speaker-detail" data-theme-section="light" data-bg-section="light">
    <div class="container">
      <div class="row">
        <div class="speaker-profile">
            <div class="speaker-image-container">
                <img
                    src={`/images/speakers/${speaker.image}`}
                    alt={speaker.name}
                    class="speaker-avatar"
                />
            </div>
            <div class="speaker-info">
                <h1>{speaker.name}</h1>
                <p class="speaker-title">{speaker.title}</p>
                <div class="speaker-bio">
                    <p>{speaker.bio}</p>
                </div>
            </div>
        </div>
      </div>
      <div class="row" style="margin-top: 3rem; text-align: center;">
          <a href="#" onclick="history.back(); return false;" class="btn-back">Back</a>
      </div>
    </div>
  </section>
</Layout>

<style>
    .speaker-detail {
        padding-top: 200px;
        padding-bottom: 80px;
        min-height: 80vh;
    }

    .speaker-profile {
        display: flex;
        flex-direction: column;
        align-items: center;
        max-width: 800px;
        margin: 0 auto;
        gap: 2rem;
    }

    @media (min-width: 768px) {
        .speaker-profile {
            flex-direction: row;
            align-items: flex-start;
            gap: 4rem;
        }
    }

    .speaker-image-container {
        width: 240px;
        height: 240px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #f0f0f0;
        position: relative;
    }

    .speaker-avatar {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        object-position: top;
        background-color: #f0f0f0;
    }

    .speaker-info {
        flex: 1;
        text-align: center;
    }

    @media (min-width: 768px) {
        .speaker-info {
            text-align: left;
        }
    }

    .speaker-info h1 {
        margin: 0 0 0.5rem 0;
        font-size: 2.5rem;
        font-family: 'Manrope', sans-serif;
    }

    .speaker-title {
        font-size: 1.2rem;
        color: #666;
        margin-bottom: 2rem;
        font-weight: 500;
    }

    .speaker-bio {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #333;
    }

    .btn-back {
        display: inline-block;
        padding: 0.8rem 2rem;
        background-color: #f5f5f5;
        color: #333;
        border-radius: 30px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s;
    }

    .btn-back:hover {
        background-color: #e0e0e0;
        transform: translateY(-2px);
    }
</style>
