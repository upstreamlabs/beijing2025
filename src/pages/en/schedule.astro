---
import Layout from "layouts/Layout.astro";
import Forumschedule from "components/Forumschedule.astro";
import scheduleDataEn from "json/Schedule-forum-en.json";
---

<Layout
  title="Schedule - GOBI 2025"
  description="GOBI 2025 Conference Schedule"
  navDarkMode={false}
  navBackground="light"
  pageTransitionName="schedule"
>
  <section class="section" data-theme-section="light" data-bg-section="light" style="padding-top: 200px; padding-bottom: 10px;">
    <div class="container">
      <div class="row" style="justify-content: center;">
        <div class="col" style="text-align: center; width: 100%;">
          <h1 style="font-family: 'Manrope', sans-serif; font-size: 2.1rem; text-align: center;">Schedule</h1>
          <p style="text-align: center;">GOBI 2025 Conference Agenda</p>
        </div>
      </div>
    </div>
  </section>

  <Forumschedule currentDay="DEC 21" scheduleData={scheduleDataEn} />
</Layout>
