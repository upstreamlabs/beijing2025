---
import speakersEn from "json/SpeakersListEn.json";
import speakersZh from "json/SpeakersListZh.json";

interface Props {
  title?: string;
}

const pathname = Astro.url.pathname;
const isChinesePage = pathname.startsWith('/cn/');
const speakers = isChinesePage ? speakersZh : speakersEn;
const { title = isChinesePage ? "演讲嘉宾" : "Featured Speakers" } = Astro.props;
---

<section
    class="section section-stats"
    data-theme-section="light"
    data-bg-section="light"
>
    <div class="container wide">
        <div class="row">
            <div class="col col-title">
                <h2>{title}</h2>
            </div>
        </div>
    </div>

    <div class="marquee-wrapper">
        <div class="speakers-track">
            {
                speakers.map((speaker) => (
                    <div class="speaker-card">
                        <div class="speaker-image-container">
                            <img
                                src={`/images/speakers/${speaker.image}`}
                                alt={speaker.name}
                                class="speaker-avatar"
                                loading="lazy"
                            />
                        </div>
                        <div class="speaker-info">
                            <h3>{speaker.name}</h3>
                            <p class="speaker-title">{speaker.title}</p>
                        </div>
                    </div>
                ))
            }
            <!-- Duplicate for seamless scrolling -->
            {
                speakers.map((speaker) => (
                    <div class="speaker-card">
                        <div class="speaker-image-container">
                            <img
                                src={`/images/speakers/${speaker.image}`}
                                alt={speaker.name}
                                class="speaker-avatar"
                                loading="lazy"
                            />
                        </div>
                        <div class="speaker-info">
                            <h3>{speaker.name}</h3>
                            <p class="speaker-title">{speaker.title}</p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
  .section-stats {
    padding-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }
  
  .section-stats h2 {
    font-family: 'Manrope', sans-serif;
    font-size: 2rem;
    text-align: center;
    margin-bottom: 3rem;
  }

  .marquee-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 2rem 0 4rem;
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  .speakers-track {
    display: flex;
    gap: 2.5rem;
    width: fit-content;
    animation: marquee 60s linear infinite;
  }
  
  /* Pause on hover for accessibility/readability */
  .speakers-track:hover {
    animation-play-state: paused;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .speaker-card {
    flex: 0 0 auto;
    width: 280px;
    padding: 2rem 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    height: 280px;
    justify-content: flex-start;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
  }
  
  .speaker-card:hover {
    transform: translateY(-10px) scale(1.02);
    /* Cyan/Blue glow */
    box-shadow: 0 20px 40px rgba(79, 172, 254, 0.25);
    background: white;
    border-color: rgba(0, 242, 254, 0.3);
  }

  /* Shimmer Shine Effect */
  .speaker-card::after {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 200%;
    height: 100%;
    background: linear-gradient(
      120deg, 
      transparent, 
      rgba(255, 255, 255, 0.4) 40%, 
      rgba(255, 255, 255, 0.0) 60%
    );
    transition: all 0.6s;
    opacity: 0;
    pointer-events: none;
    z-index: 10;
  }

  .speaker-card:hover::after {
    left: 100%;
    opacity: 1;
    transition: 0.8s;
  }

  .speaker-image-container {
    width: 120px;
    height: 120px;
    flex-shrink: 0;
    margin-bottom: 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    transition: all 0.4s ease;
  }

  .speaker-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
    background-color: #f0f0f0;
    z-index: 1;
  }
  
  .speaker-info {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    z-index: 2;
  }

  .speaker-info h3 {
    margin: 0.5rem 0 0.25rem 0;
    font-size: 1.35rem;
    color: #0d1c3a;
    font-weight: 800;
    font-family: 'Manrope', 'Inter', sans-serif;
    letter-spacing: -0.02em;
  }

  .speaker-title {
    margin: 0;
    font-size: 0.9rem;
    color: #666;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .marquee-wrapper {
        padding: 1rem 0 2rem;
    }
    
    .speakers-track {
        gap: 1.5rem;
    }

    .speaker-card {
      width: 240px;
      height: 240px;
      padding: 1.5rem 1rem;
    }

    .speaker-image-container {
      width: 100px;
      height: 100px;
    }
  }
</style>
