---
import Button from "./Button.astro";
---

<section class="section section-quick-links" data-theme-section="light">
  <div class="container">
    <div class="row">
      <div class="col-12 quick-links-wrapper">
         <Button
            text="Detailed Schedule"
            link="/en/schedule"
            class="btn outline xl btn-hover"
         />
         <Button
            text="Speakers Info"
            link="/en/speakers"
            class="btn outline xl btn-hover"
         />
         <Button
            text="Upstream Camp"
            link="https://camp.upstreamlabs.org/"
            openInNewTab={true}
            class="btn outline xl btn-hover"
         />
      </div>
    </div>
  </div>
</section>

<style>
  .section-quick-links {
    padding: 3rem 0;
    /* Blend with the page background or provide a distinct one */
    background-color: var(--color-background); 
  }

  .quick-links-wrapper {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
  }
</style>
